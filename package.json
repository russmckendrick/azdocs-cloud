{
  "name": "azdocs-cloud",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:azdocs": "node scripts/sync-azdocs.mjs",
    "build:demo": "node scripts/build-desktop-demo.mjs",
    "check:demo": "node scripts/check-desktop-demo.mjs",
    "prepare:exports": "node scripts/prepare-product-exports.mjs",
    "prepare:report-pages": "node scripts/prepare-report-pages.mjs",
    "refresh:exports": "node scripts/refresh-product-exports.mjs",
    "check:exports": "node scripts/check-product-exports.mjs",
    "prepare:site": "pnpm prepare:exports && pnpm prepare:report-pages && pnpm build:demo && pnpm sync:azdocs && pnpm check:demo && pnpm check:exports",
    "dev": "pnpm prepare:site && astro dev",
    "build": "pnpm prepare:site && astro check && astro build",
    "check": "pnpm prepare:site && astro check",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.3.0",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/markdown-remark": "^7.3.1",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.132.0"
  }
}
