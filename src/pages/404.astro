---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — azdocs" description="The requested azdocs.cloud page was not found.">
  <section class="not-found section-shell">
    <img src="/docs/marks/assets/azdocs-mark-reversed.svg" alt="" />
    <h1>That route isn’t in the map.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/">Back to azdocs</a>
      <a class="button button-secondary" href="/docs/">Open documentation</a>
    </div>
  </section>
</BaseLayout>

