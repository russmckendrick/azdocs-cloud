---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductStory from "../components/ProductStory.astro";
import reportManifest from "../../public/product-exports/manifest.json";
import reportPages from "../../public/product-exports/pages/manifest.json";
import "../styles/product-story.css";

const reportUrl = `/product-exports/azure-estate-report.html?v=${reportManifest.outputSha256.slice(0, 12)}`;
const pdfFileUrl = `/product-exports/azure-estate-report.pdf?v=${reportManifest.pdfOutputSha256.slice(0, 12)}`;
const pdfUrl = `${pdfFileUrl}#view=FitH`;
const pageUrl = (page: typeof reportPages.pages[number]) =>
  `/product-exports/pages/${page.file}?v=${page.sha256.slice(0, 12)}`;
---

<BaseLayout className="landing-page">
  <ProductStory />

  <section class="export-proof section-shell" id="exports">
    <div class="export-proof-heading">
      <h2>This is an azdocs assessment.</h2>
      <p>
        Read the richer 23-page PDF, generated by azdocs from its sample Azure
        estate. The standalone HTML remains available too.
      </p>
    </div>
    <div class="export-browser">
      <div class="export-browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>azure-estate-report.pdf · 23 pages</span></div>
      <div class="pdf-gallery-surface pdf-gallery-scroll">
        <div class="pdf-page-grid">
          {reportPages.pages.map((page) => (
            <button type="button" data-pdf-page data-page={page.page} data-src={pageUrl(page)} data-pdf-href={`${pdfFileUrl}#page=${page.page}&view=FitH`} aria-label={`Open PDF page ${page.page} in a larger view`}>
              <img src={pageUrl(page)} alt={`Azure Estate Report page ${page.page}`} width="794" height="1123" loading={page.page <= 3 ? "eager" : "lazy"} decoding="async" />
              <span>{String(page.page).padStart(2, "0")}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
    <div class="export-proof-note">
      <strong>Contoso Ltd · sample estate · generated from the current renderer</strong>
      <span><a class="text-link" href={pdfUrl} target="_blank" rel="noopener">Open PDF ↗</a><a class="text-link" href={reportUrl} target="_blank" rel="noopener">HTML version ↗</a></span>
    </div>
    <div class="format-line" aria-label="Export formats supported by azdocs"><span>PDF</span><span>DOCX</span><span>XLSX</span><span>CSV</span><span>draw.io</span><span>SVG</span><span>PNG</span><span>HTML</span></div>
  </section>

  <dialog class="pdf-lightbox" data-pdf-dialog aria-labelledby="pdf-lightbox-title">
    <div class="pdf-lightbox-bar">
      <div><strong id="pdf-lightbox-title">Azure Estate Report</strong><span data-pdf-position>Page 1 of {reportPages.pages.length}</span></div>
      <form method="dialog"><button type="submit" class="pdf-close" aria-label="Close PDF page viewer">×</button></form>
    </div>
    <div class="pdf-lightbox-page"><img data-pdf-image src={pageUrl(reportPages.pages[0])} alt="Azure Estate Report page 1" width="794" height="1123" /></div>
    <div class="pdf-lightbox-controls">
      <button type="button" data-pdf-previous>← Previous</button>
      <a href={`${pdfFileUrl}#page=1&view=FitH`} target="_blank" rel="noopener" data-pdf-original>Open original PDF ↗</a>
      <button type="button" data-pdf-next>Next →</button>
    </div>
  </dialog>

  <section class="straight-section section-shell" id="workflow">
    <div class="straight-copy">
      <h2>Online to collect.<br />Offline after that.</h2>
      <p>azdocs stores the collected Azure evidence in a local SQLite snapshot. The desktop app, comparisons, reports, and diagrams work from that saved state.</p>
      <a class="text-link" href="/docs/usage/collecting/">Read how collection works <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9h11M10 5l4 4-4 4" /></svg></a>
    </div>
    <div class="straight-flow" aria-label="azdocs collection workflow">
      <article><img src="/azure-icons/subscription.svg" alt="" /><h3>Collect</h3><p>Read-only Azure collection.</p></article><span aria-hidden="true"></span>
      <article><img src="/azure-icons/storage-account.svg" alt="" /><h3>Store</h3><p>Local SQLite snapshot.</p></article><span aria-hidden="true"></span>
      <article><img src="/azure-icons/download.svg" alt="" /><h3>Use</h3><p>Explore, compare, export.</p></article>
    </div>
  </section>

  <section class="final-install section-shell">
    <div><h2>Install it. Then point it at Azure.</h2><p>The full installation, configuration, collection, desktop, report, and diagram documentation is imported from the azdocs project at build time.</p></div>
    <div class="final-install-actions"><a class="button button-primary" href="/docs/usage/installation/">Install azdocs</a><a class="button button-secondary" href="/docs/">Open documentation</a></div>
  </section>

  <footer class="site-footer">
    <div class="section-shell footer-inner"><img src="/docs/marks/assets/azdocs-lockup-reversed.svg" alt="azdocs" /><p>Read-only Azure estate documentation.</p><div><a href="/docs/">Docs</a><a href="https://github.com/russmckendrick/azdocs">GitHub</a><a href="https://github.com/russmckendrick/azdocs/blob/main/LICENSE">MIT licence</a></div></div>
  </footer>
</BaseLayout>

<script src="../scripts/report-gallery.ts"></script>
