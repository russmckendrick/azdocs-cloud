{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azdocs-cloud",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "azdocs.cloud", "custom_domain": true },
    { "pattern": "www.azdocs.cloud", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
